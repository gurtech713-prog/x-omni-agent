<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility service configuration.

    Event types subscribed to:
      - typeWindowStateChanged    : activity transitions, dialog open/close
      - typeWindowContentChanged  : in-place content updates (text, scrolling, focus)
      - typeWindowsChanged        : window list changes — REQUIRED by WindowTracker
                                    to detect keyboard / PiP / shade visibility.
                                    Without this event, isKeyboardVisible /
                                    isPictureInPictureVisible never flip to true
                                    and clearBlockingOverlays() can't dismiss
                                    the keyboard before tapping — the agent's
                                    tap would land on a keyboard key instead of
                                    the field behind it.
      - typeViewClicked           : tap confirmation — used by SuccessMonitor to
                                    detect when a scheduled tap actually fired.
      - typeViewFocused           : focus changes — lets the agent track the
                                    active input field across IME show/hide.
      - typeViewScrolled          : scroll events — used to confirm a swipe
                                    gesture completed and to detect lazy-loaded
                                    content (e.g. a feed paginating in more rows).
      - typeViewTextChanged       : text input events — used by BehaviorRecorder
                                    to capture form-field values during recording
                                    (V-M16: previously missing, so the agent
                                    couldn't observe text it had typed).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewClicked|typeViewFocused|typeViewScrolled|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:isAccessibilityTool="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility service configuration.

    Event types subscribed to:
      - typeWindowStateChanged    : activity transitions, dialog open/close
      - typeWindowContentChanged  : in-place content updates (text, scrolling, focus)
      - typeWindowsChanged        : window list changes — REQUIRED by WindowTracker
                                    to detect keyboard / PiP / shade visibility.
                                    Without this event, isKeyboardVisible /
                                    isPictureInPictureVisible never flip to true
                                    and clearBlockingOverlays() can't dismiss
                                    the keyboard before tapping — the agent's
                                    tap would land on a keyboard key instead of
                                    the field behind it.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:isAccessibilityTool="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for X-OmniClaw.

    Policy:
      - Default: enforce TLS (cleartext disabled). All cloud LLM / STT / VLM
        endpoints (OpenAI, Gemini, OpenRouter, SiliconFlow, etc.) must use HTTPS.
      - Exception: allow cleartext HTTP ONLY for loopback addresses
        (127.0.0.1, localhost) and the emulator's host alias (10.0.2.2).
        This is required for local model servers like Ollama (default
        http://localhost:11434) and LM Studio (http://localhost:1234) which
        don't use TLS on the loopback interface.

    Rationale: cleartext to loopback never leaves the device, so there's no
    MITM risk. Allowing it globally, however, would let a misconfigured
    provider URL silently downgrade to HTTP and leak API keys over the wire.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

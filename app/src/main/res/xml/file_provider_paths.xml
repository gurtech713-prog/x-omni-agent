<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Files exported by SettingsViewModel.exportConfig() (getExternalFilesDir). -->
    <external-files-path
        name="exports"
        path=".xomniclaw/" />
    <!-- Skills written by BehaviorRecorder.saveSkill() and SkillRepository. -->
    <files-path
        name="skills"
        path="skills/" />
    <!-- LiteRT models extracted from assets (rarely shared, but possible). -->
    <files-path
        name="litert_models"
        path="litert_models/" />
    <!--
        Shareable temp files only. Restricted to the cacheDir/shared/
        subdirectory (File(cacheDir, "shared/")) instead of the entire
        cacheDir so unrelated cached data (intermediate screenshots, temp
        downloads, sensitive caches) is never exposed via content:// URIs.

        V-L6: REMOVED the `<files-path name="behavior" path="behavior/" />`
        entry. BehaviorRecorder stores raw input-event traces + screenshots
        under filesDir/behavior/ — these contain potentially sensitive user
        actions (typed passwords, tapped UI elements) and should NEVER be
        shareable to other apps via content:// URIs. If a future feature
        legitimately needs to share a behavior trace, write a curated/redacted
        copy to cacheDir/shared/ instead of exposing the whole directory.
    -->
    <cache-path
        name="cache"
        path="shared/" />
</paths>
